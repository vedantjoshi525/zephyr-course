menu "Application"

config APP_HEARTBEAT_PERIOD_MS
	int "Heartbeat period in milliseconds"
	default 500
	range 100 2000
	help
	  Heartbeat LED blink period in milliseconds.

endmenu

menu "LED Subsystem"

config LED_SUBSYSTEM
    bool "LED Subsystem"
    default y
    help
      Enable the LED subsystem.

if LED_SUBSYSTEM

choice
    prompt "LED blink sleep time"
    default BLINK_SLEEP_1000MS

config BLINK_SLEEP_250MS
    bool "250 ms (fast)"

config BLINK_SLEEP_500MS
    bool "500 ms (medium)"

config BLINK_SLEEP_1000MS
    bool "1s (medium)"

config BLINK_SLEEP_2000MS
    bool "2s (slow)"

endchoice

config BLINK_SLEEP_TIME_MS
    int
    default 250 if BLINK_SLEEP_250MS
    default 500 if BLINK_SLEEP_500MS
    default 1000 if BLINK_SLEEP_1000MS
    default 2000 if BLINK_SLEEP_2000MS
    default 1000
    help
        Internal blink sleep time in milliseconds.

menuconfig LED_ADVANCED_SETTINGS
    bool "Advanced LED settings"
    default n
    help
        Enable advanced LED settings.

if LED_ADVANCED_SETTINGS

config LED_BRIGHTNESS
    int "LED brightness (0-100)"
    default 100
    range 0 100
    help
        Set LED brightness level from 0 to 100.

config LED_FADE_DURATION
    int "LED fade duration (ms)"
    default 500
    range 0 5000
    help
        Duration of LED fade effect in milliseconds.

menu "Expert settings"

config LED_DEBUGGING
    bool "Enable LED debugging"
    default n
    help
        Enable debug logging for the LED subsystem.

config LED_CUSTOM_BLINK_PATTERN
    bool "Custom blink pattern"
    default n
    help
        Enable a custom blink pattern for the LED.

endmenu #Expert settings
endif #LED_ADVANCED_SETTINGS
endif #LED_SUBSYSTEM
endmenu #LED Subsystem

source "Kconfig.zephyr"